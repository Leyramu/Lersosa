# 生产环境配置
VITE_APP_BASE_PATH=/
VITE_APP_PORT=3000
VITE_APP_API_URL=https://ai.leyramu.top:8004
VITE_APP_BASE_API=/api
VITE_APP_HTTPS=true
VITE_APP_HTTPS_KEY=certs/lersosa-vite-server-key.pem
VITE_APP_HTTPS_CERT=certs/lersosa-vite-server-cert.pem
VITE_APP_HTTPS_CA=certs/lersosa-ca-cert.pem
VITE_APP_PROXY_CLIENT_KEY=certs/lersosa-vite-client-key.pem
VITE_APP_PROXY_CLIENT_CERT=certs/lersosa-vite-client-cert.pem
VITE_APP_PROXY_SECURE=true
VITE_APP_PROXY_CHANGE_ORIGIN=true
VITE_BUILD_COMPRESS=gzip
